    },
    {
      "scene": 3,
      "fromFrame": 330,
      "durationInFrames": 330,
      "narration": "Trains, strangers, their joy and their grief. Real life does not live inside a classroom.",
      "exaggeration": 0.65,
      "cfg_weight": 0.4
    },
    {
      "scene": 4,
      "fromFrame": 660,
      "durationInFrames": 240,
      "narration": "On day twenty-one, they were waiting at my gate.",
